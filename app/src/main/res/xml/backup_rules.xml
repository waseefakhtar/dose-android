<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup configuration for personal use.

   This app is configured to backup all data including the medication database
   to Google Drive for easy transfer to new devices.

   For personal use with sole access to Google account, this is an acceptable
   trade-off between security and convenience. Medication data is backed up
   alongside other personal data already in Google account (email, photos, etc.)

   See https://developer.android.com/guide/topics/data/autobackup for details.
-->
<full-backup-content>
    <!-- Backup all app data including medication database -->
    <include domain="database" path="."/>
    <include domain="sharedpref" path="."/>

    <!-- Exclude local crash logs (device-specific debugging) -->
    <exclude domain="file" path="crash_logs"/>
</full-backup-content>